<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BookbudApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookBud"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.BookBud.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.auth.presentation.activity.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".features.dashboard.presentation.activity.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".features.admin.presentation.activity.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".features.auth.presentation.activity.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".features.auth.presentation.activity.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".features.auth.presentation.activity.GetStartedActivity"
            android:exported="false" />

    </application>

</manifest>
