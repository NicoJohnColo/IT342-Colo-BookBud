<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Hover state: orange border -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="3dp" android:left="1dp" android:right="1dp">
                <shape>
                    <solid android:color="@color/bb_orange" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="@color/bb_card_white" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="@color/bb_orange" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <item android:bottom="3dp" android:left="1dp" android:right="1dp">
                <shape>
                    <solid android:color="#DDD5CC" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="@color/bb_card_white" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
