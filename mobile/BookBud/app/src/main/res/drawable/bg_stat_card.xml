<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Hover state: orange border -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@color/bb_orange" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@color/bb_card_white" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="@color/bb_orange" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="#E8E0D8" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@color/bb_card_white" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
