<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Management"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark" />

            <TextView
                android:id="@+id/resultsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 results"
                android:textSize="13sp"
                android:textColor="@color/bb_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@android:color/white">

        <EditText
            android:id="@+id/searchBooks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search title, author or owner..."
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:scrollbars="none"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_hot"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterAvailable"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Available"
                android:textSize="13sp"
                android:textColor="@color/bb_text_dark"
                android:background="@drawable/bg_badge_gray"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterRented"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Rented"
                android:textSize="13sp"
                android:textColor="@color/bb_text_dark"
                android:background="@drawable/bg_badge_gray"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterOnHold"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="On Hold"
                android:textSize="13sp"
                android:textColor="@color/bb_text_dark"
                android:background="@drawable/bg_badge_gray"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterSold"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sold"
                android:textSize="13sp"
                android:textColor="@color/bb_text_dark"
                android:background="@drawable/bg_badge_gray"
                android:paddingHorizontal="16dp"
                android:gravity="center" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBooks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- RecyclerView for Books -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/booksRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:padding="12dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No books found"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#999999"
        android:visibility="gone" />
</LinearLayout>
