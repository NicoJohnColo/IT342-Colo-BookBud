<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/bb_card_white"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Listing"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update your book listing"
                android:textSize="13sp"
                android:textColor="@color/bb_text_muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Title *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter book title"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Author Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Author *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editAuthor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter author name"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Genre Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerGenre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:layout_marginBottom="16dp" />

            <!-- Condition Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Condition *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerCondition"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:layout_marginBottom="16dp" />

            <!-- Transaction Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction Type *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/transactionTypeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp" />

            <!-- Rental Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rental Price (P/day)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editPriceRent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 40"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp" />

            <!-- Sale Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sale Price (P)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editPriceSale"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 180"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text_dark"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Brief description of your book"
                android:padding="12dp"
                android:background="@color/bb_card_white"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="16dp"
                android:maxLines="5" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Update Listing"
                android:backgroundTint="@color/bb_orange"
                android:textColor="@android:color/white"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
