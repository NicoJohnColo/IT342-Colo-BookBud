<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Book Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Avatar -->
            <TextView
                android:id="@+id/bookAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="H"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_book_avatar"
                android:layout_marginEnd="12dp" />

            <!-- Book Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harry Potter and the Sorcerer's Stone"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2C2C2C"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/bookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="J.K. Rowling"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/bookGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fantasy • Like New"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/bookWishlistIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@owner_username"
                    android:textSize="11sp"
                    android:textColor="#F4622A"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Status Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/bookTransactionType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_hot"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/bookPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱220"
                    android:textSize="14sp"
                    android:textColor="#F4622A"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUnavailable"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Set Unavailable"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_danger" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
