<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Book Cover Placeholder + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Cover Image Placeholder -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:background="#E0E0E0"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/bookAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="H"
                    android:textSize="28sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="#F4622A" />
            </FrameLayout>

            <!-- Book Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harry Potter and the Sorcerer's Stone"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2C2C2C"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/bookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="J.K. Rowling"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/bookGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fantasy • Like New"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/bookPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="₱220"
                        android:textSize="14sp"
                        android:textColor="#F4622A"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/bookTransactionType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sale"
                        android:textSize="11sp"
                        android:textColor="#F4622A"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="#FFF3E0"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Wishlist Heart -->
            <TextView
                android:id="@+id/bookWishlistIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="24sp"
                android:textColor="#BDBDBD"
                android:layout_gravity="top|end"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
