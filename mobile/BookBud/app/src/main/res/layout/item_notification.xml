<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Icon + Title + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Icon/Avatar -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#F4622A"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/notifIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔔"
                    android:textSize="20sp" />
            </FrameLayout>

            <!-- Title + Time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notifTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="darsh_ropes"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2C2C2C" />

                <TextView
                    android:id="@+id/notifTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jan 28"
                    android:textSize="11sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <!-- Unread Indicator -->
            <View
                android:id="@+id/notifUnreadDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_unread_dot"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Message -->
        <TextView
            android:id="@+id/notifMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jay M is interested in your listing: Darling Rose Gold"
            android:textSize="13sp"
            android:textColor="#2C2C2C"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="12dp" />

        <!-- Sub-details -->
        <TextView
            android:id="@+id/notifSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transaction Created"
            android:textSize="11sp"
            android:textColor="#F4622A"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp">

            <Button
                android:id="@+id/notifActionUnread"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="Mark Unread"
                android:textSize="11sp"
                android:textColor="#F4622A"
                android:background="@drawable/bg_button_outline"
                android:layout_marginEnd="4dp"
                style="?attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/notifActionDelete"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_danger"
                android:layout_marginStart="4dp"
                style="?attr/borderlessButtonStyle" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
